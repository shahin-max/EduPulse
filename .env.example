# Copy to .env.local. Base URL of the EduPulse API (the Edupulse-api NestJS app), including the /api/v1 prefix.
NEXT_PUBLIC_API_URL=http://localhost:34567/api/v1
# Public address of this website (no trailing slash), for the sitemap, canonical URLs and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID. Defaults to the academy's own (G-DEKTDK10KW); set only to override. Analytics only ever
# runs on https://edupulseindia.com, never on staging, local copies or the portal pages.
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag code (the content="..." value). Only needed if the domain is not verified by DNS.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
